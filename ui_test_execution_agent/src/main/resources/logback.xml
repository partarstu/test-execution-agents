<configuration>
    <!-- Safety net: every log message is written with the registered secrets replaced by their placeholders. -->
    <conversionRule conversionWord="redactedMsg" class="org.tarik.ta.core.security.SecretRedactingMessageConverter"/>
    <conversionRule conversionWord="redactedEx" class="org.tarik.ta.core.security.SecretRedactingThrowableConverter"/>

    <!-- "json" gives one JSON object per event for the cloud log collectors; anything else keeps the readable pattern. -->
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-text}"/>
    <include resource="logback-appenders-${LOG_FORMAT}.xml"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="org.eclipse.jetty" level="OFF"/>
    <logger name="dev.langchain4j.http.client.log" level="OFF"/>
    <logger name="dev.langchain4j" level="INFO"/>
    <logger name="io.grpc.netty" level="INFO"/>
    <logger name="io.a2a.server" level="INFO"/>
</configuration>
