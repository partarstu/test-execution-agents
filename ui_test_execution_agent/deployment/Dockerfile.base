# Base Dockerfile for UI Test Execution Agent
# Provides: Ubuntu 26.04 + Xfce + TigerVNC + Google Chrome

FROM ubuntu:26.04

LABEL maintainer="partarstu@gmail.com"
LABEL description="Ubuntu 26.04 with Xfce, TigerVNC and Google Chrome for UI testing"

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Vienna

# --- System Configuration ---
ARG DEFAULT_USER=ubuntu
ARG DEFAULT_USER_ID=1000
ARG DEFAULT_GROUP_ID=1000
ARG VNC_RESOLUTION=1920x1080
ARG VNC_COL_DEPTH=24

# --- Install Core Packages ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Xfce desktop environment
    xfce4 \
    xfce4-goodies \
    xfce4-terminal \
    # VNC server
    tigervnc-standalone-server \
    tigervnc-common \
    tigervnc-tools \
    # Utilities (matching original accetto image)
    wget \
    curl \
    git \
    zip \
    unzip \
    jq \
    iputils-ping \
    net-tools \
    lsof \
    # X11 and display utilities
    dbus-x11 \
    x11-utils \
    x11-xserver-utils \
    xdg-utils \
    # Font packages for proper rendering
    fonts-liberation \
    fonts-dejavu-core \
    # For SSL certificate generation
    openssl \
    # Additional dependencies
    libgtk-3-0 \
    libgbm1 \
    libasound2t64 \
    libnss3 \
    libxss1 \
    libappindicator3-1 \
    libindicator3-7 \
    sudo \
    ca-certificates \
    gnupg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Install Google Chrome Stable (latest) ---
# Download directly from Google's "current" endpoint so every build gets the newest stable release
RUN wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    -O /tmp/google-chrome.deb \
    && apt-get install -y /tmp/google-chrome.deb \
    && rm /tmp/google-chrome.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Configure Default User ---
# Ubuntu 26.04 has a default 'ubuntu' user with UID/GID 1000, we use it directly
RUN echo "${DEFAULT_USER}:${DEFAULT_USER}" | chpasswd && \
    usermod -aG sudo ${DEFAULT_USER} && \
    echo "${DEFAULT_USER} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Configure VNC ---
RUN mkdir -p /home/${DEFAULT_USER}/.config/tigervnc \
    && mkdir -p /home/${DEFAULT_USER}/Desktop

# Create VNC startup script
RUN echo '#!/bin/bash\n\
unset SESSION_MANAGER\n\
unset DBUS_SESSION_BUS_ADDRESS\n\
export XDG_RUNTIME_DIR=/tmp/runtime-ubuntu\n\
mkdir -p $XDG_RUNTIME_DIR\n\
chmod 700 $XDG_RUNTIME_DIR\n\
exec startxfce4\n\
' > /home/${DEFAULT_USER}/.config/tigervnc/xstartup \
    && chmod +x /home/${DEFAULT_USER}/.config/tigervnc/xstartup

# Create VNC configuration
RUN echo "geometry=${VNC_RESOLUTION}\n\
depth=${VNC_COL_DEPTH}\n\
alwaysshared\n\
" > /home/${DEFAULT_USER}/.config/tigervnc/config

# --- Create Startup Script ---
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Set resolution from environment variable\n\
VNC_RESOLUTION=${VNC_RESOLUTION:-"1920x1080"}\n\
sed -i "s/^geometry=.*/geometry=$VNC_RESOLUTION/" /home/ubuntu/.config/tigervnc/config\n\
\n\
# Xvnc listens only on a Unix socket of the ubuntu user and asks for no password: the operator panel relays it, and its\n\
# login is the only credential. Every listener and security option is given here, because the command line overrides\n\
# both user configuration files. Without live control a viewer only watches; no viewer may resize the display the agent drives.\n\
if [ "${PANEL_LIVE_CONTROL_ENABLED}" = "true" ]; then VIEWER_INPUT=1; else VIEWER_INPUT=0; fi\n\
echo "Starting VNC server on display :1 (viewer input: $VIEWER_INPUT)..."\n\
su - ubuntu -c "vncserver :1 -geometry $VNC_RESOLUTION -depth 24 -localhost yes -rfbport -1 -SecurityTypes None -rfbunixpath /tmp/xvnc.sock -rfbunixmode 0600 -AcceptSetDesktopSize=0 -AcceptPointerEvents=$VIEWER_INPUT -AcceptKeyEvents=$VIEWER_INPUT -AcceptCutText=$VIEWER_INPUT -SendCutText=$VIEWER_INPUT"\n\
\n\
echo "VNC server is running on the Unix socket /tmp/xvnc.sock, without a TCP listener."\n\
\n\
# Execute any additional command passed to the container\n\
if [ -n "$1" ]; then\n\
    exec "$@"\n\
else\n\
    # Keep container running\n\
    tail -f /dev/null\n\
fi\n\
' > /usr/local/bin/startup.sh \
    && chmod +x /usr/local/bin/startup.sh

# --- Configure Chrome Settings ---
# Configure Chrome to run with necessary flags for Docker
# Create the "First Run" sentinel file to skip the first-run experience
# Also configure Local State to disable various first-run prompts
RUN mkdir -p /home/${DEFAULT_USER}/.config/google-chrome/Default \
    && touch /home/${DEFAULT_USER}/.config/google-chrome/First\ Run \
    && echo '{"browser":{"check_default_browser":false,"show_home_button":false,"enabled_labs_experiments":["allow-insecure-localhost"]},"distribution":{"suppress_first_run_bubble":true,"suppress_first_run_default_browser_prompt":true,"make_chrome_default_for_user":false},"profile":{"default_content_setting_values":{"notifications":2}}}' \
    > /home/${DEFAULT_USER}/.config/google-chrome/Local\ State 2>/dev/null || true

# Create Chrome launcher with proper flags
RUN echo '[Desktop Entry]\n\
Version=1.0\n\
Name=Google Chrome\n\
Exec=google-chrome-stable --no-sandbox --disable-gpu --disable-dev-shm-usage %U\n\
Terminal=false\n\
Icon=google-chrome\n\
Type=Application\n\
Categories=Network;WebBrowser;\n\
' > /home/${DEFAULT_USER}/Desktop/google-chrome.desktop \
    && chmod +x /home/${DEFAULT_USER}/Desktop/google-chrome.desktop

# --- Set Ownership ---
# IMPORTANT: This must be done AFTER all home directory modifications
RUN chown -R ${DEFAULT_USER}:${DEFAULT_USER} /home/${DEFAULT_USER}

# --- Environment Variables ---
ENV DISPLAY=:1
ENV VNC_RESOLUTION=${VNC_RESOLUTION}
ENV HOME=/home/${DEFAULT_USER}
ENV USER=${DEFAULT_USER}

# --- Entrypoint ---
ENTRYPOINT ["/usr/local/bin/startup.sh"]
