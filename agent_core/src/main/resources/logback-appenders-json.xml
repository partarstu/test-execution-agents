<!--
  One JSON object per log event, used when LOG_FORMAT=json (the cloud images set it). Included by each agent's
  logback.xml. The field names are the logstash defaults, and the message goes through the "pattern" provider so that
  the secret-redacting conversion word applies to it here exactly as it does in text mode.
  -->
<included>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger_name</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread_name</fieldName>
                </threadName>
                <pattern>
                    <pattern>{"message":"%redactedMsg"}</pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="org.tarik.ta.core.security.SecretRedactingThrowableConverter"/>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-log}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-log}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>1</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger_name</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread_name</fieldName>
                </threadName>
                <pattern>
                    <pattern>{"message":"%redactedMsg"}</pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="org.tarik.ta.core.security.SecretRedactingThrowableConverter"/>
                </stackTrace>
            </providers>
        </encoder>
    </appender>
</included>
