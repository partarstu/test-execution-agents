FROM amazoncorretto:27-alpine

ARG APP_DIR=/app
ARG APP_LOG_DIR=${APP_DIR}/log
ARG SOURCE_JAR_PATH=procedure_knowledge_agent/target/procedure-knowledge-agent-3.1.0-SNAPSHOT.jar
ARG DESTINATION_JAR_PATH=${APP_DIR}/app.jar

RUN apk add --no-cache curl ca-certificates

RUN mkdir -p ${APP_DIR} ${APP_LOG_DIR}

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY ${SOURCE_JAR_PATH} ${DESTINATION_JAR_PATH}

RUN chown -R appuser:appgroup ${APP_DIR}

USER appuser

WORKDIR ${APP_DIR}

ENV APP_JAR_PATH=${DESTINATION_JAR_PATH}
ENV LOG_DIR=${APP_LOG_DIR}
ENV DEPLOYMENT_ENV="cloud"
ENV TZ="Europe/Vienna"

# The agent reads AGENT_HOST and PORT through AgentConfig.
ENV AGENT_HOST="0.0.0.0"
ENV PORT="8007"

EXPOSE 8007

# Dependencies still call the deprecated sun.misc.Unsafe memory-access methods, which JDK 27 otherwise warns about (JEP 498).
ENTRYPOINT ["java", "--sun-misc-unsafe-memory-access=allow", "-jar", "/app/app.jar"]
